[Container]
Image=docker.io/nicolargo/glances:4.5.9@sha256:1d994d181732cfbf68b7c5826a1f71b89624e3eaaa2fe28b28048b2f61b200d7
ContainerName=glances

Network=glances.network

# generate glances.pwd by running `glances -w --password` in a temporary glances container
Secret=glances_password_file,target=/app/.config/glances/glances.pwd,uid=1000,gid=1000,mode=0400

Timezone=local

Environment=GLANCES_OPT="-w --disable-webui --password"

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:61208/api/4/status || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:61208/api/4/status || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=50

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
